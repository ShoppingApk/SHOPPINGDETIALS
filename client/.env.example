# Copy to client/.env for local development. On Vercel, set it under Settings → Environment Variables.
# Backend base URL, no trailing slash.
#   Local:      http://localhost:5000
#   Production: https://<your-render-service>.onrender.com
# Vite bakes this in at build time: redeploy on Vercel after changing it.
# Never put secrets in VITE_ variables; everything here is public in the browser.
VITE_API_URL=http://localhost:5000
