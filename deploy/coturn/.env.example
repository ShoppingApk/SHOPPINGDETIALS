# Copy to .env on the VM (never commit .env).

# Long random secret. Must be EXACTLY the same as TURN_SHARED_SECRET on Render.
#   openssl rand -hex 32
TURN_SHARED_SECRET=replace_with_a_long_random_secret

# The VM's public IP. On Oracle Cloud / Google Cloud the VM only sees a private IP, so use
# "PUBLIC/PRIVATE", e.g. 140.238.10.20/10.0.0.15 (find the private one with: hostname -I)
EXTERNAL_IP=203.0.113.10/10.0.0.15

# Any name; a domain name if you have one (e.g. turn.example.com).
TURN_REALM=kaasni
