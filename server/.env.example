# Copy to server/.env for local development. On Render, set these in Environment.
# Never commit the real .env file.

# ---- Server ----
PORT=5000                      # Render sets PORT automatically; leave it out there
NODE_ENV=development           # "production" on Render

# MongoDB Atlas connection string (free M0 cluster). Database name goes after ".net/".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaasni?retryWrites=true&w=majority

# JWT signing secret: at least 32 random characters (the server refuses weak values in production).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS and Socket.IO. Comma-separated, no trailing slash.
#   Local: http://localhost:5173    Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ---- Private messaging ----
# Word that unlocks the private area for chatusers when typed in the search bar. Choose your own.
CHAT_UNLOCK_KEYWORD=change_me
# AES-256 key for message encryption: exactly 64 hex characters. Keep a safe copy: if it is lost
# or changed, existing messages can no longer be decrypted. Use the SAME value everywhere that
# shares the same database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_characters

# ---- Audio / video calls: STUN/TURN (optional) ----
# Which ICE servers browsers use to connect calls. Secrets stay on the server; browsers get
# short-lived credentials from GET /api/chat/ice-servers. Never put these in VITE_ variables.
#   none           STUN only (default). Free, no account. Most Wi-Fi calls work; some mobile/
#                  office networks need TURN.
#   static         Fixed TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL (any TURN provider).
#   coturn-secret  Your own coturn (deploy/coturn): TURN_URLS + TURN_SHARED_SECRET.
#                  Credentials valid 1 hour, signed with HMAC-SHA1.
#   cloudflare     Cloudflare Realtime TURN: TURN_KEY_ID + TURN_KEY_API_TOKEN.
#   metered        Metered.ca TURN: METERED_API_KEY + METERED_APP_NAME.
TURN_PROVIDER=none

# static / coturn-secret: comma-separated TURN URLs (never port 53, browsers block it), e.g.
#   turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# static only
TURN_USERNAME=
TURN_CREDENTIAL=
# coturn-secret only: same value as static-auth-secret on the coturn server (openssl rand -hex 32)
TURN_SHARED_SECRET=
# cloudflare only: Cloudflare dashboard -> Realtime -> TURN Server -> create key
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# metered only: dashboard.metered.ca -> Developers -> TURN credentials API key, and your app
# name (the "yourapp" part of yourapp.metered.live)
METERED_API_KEY=
METERED_APP_NAME=

# ---- Cloudinary (optional) ----
# Needed for uploading product photos from the admin panel and sharing images in messages.
# Without it, products use image links and message image sharing is turned off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- First admin (used by `npm run seed` and `npm run create-admin`) ----
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
